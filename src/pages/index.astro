---
import MainLayout from '@/layouts/MainLayout.astro';
import constructionImage from '@images/construction-image.avif';
import aerialImage from '@images/aerial-view.avif';
import blueprintImage from '@images/blueprints-image.avif';
import workersImage from '@images/construction-workers.avif';
---

<MainLayout
  title="PARK'ES YAPI | Eskişehir İnşaat ve Yapı Çözümleri"
  lang="tr"
  customDescription="PARK'ES YAPI, Eskişehir'de güvenli, estetik ve değer katan yapılar inşa eder. Projenizi birlikte hayata geçirelim."
>
  <div class="parkes-page">
    <section class="parkes-hero" id="anasayfa">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Eskişehir'de güvenle inşa ediyoruz</p>
        <h1>Yaşanacak<br /><em>alanlar</em> inşa ediyoruz.</h1>
        <p class="hero-lede">PARK'ES YAPI; sağlam mühendislik, zamansız tasarım ve şeffaf süreçlerle hayallerinizdeki yapıyı gerçeğe dönüştürür.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#iletisim">Projenizi Konuşalım <span>↗</span></a>
          <a class="text-link" href="#projeler">Projelerimizi keşfedin <span>↓</span></a>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img src={aerialImage.src} alt="Eskişehir'de modern bir konut projesi" />
        <div class="hero-badge"><strong>15+</strong><span>yıllık<br />tecrübe</span></div>
      </div>
      <div class="hero-note">PARK'ES YAPI <span>—</span> ESKİŞEHİR / TÜRKİYE</div>
    </section>

    <section class="intro-section" id="hakkimizda">
      <div class="section-label">01 / BİZ KİMİZ</div>
      <div class="intro-content">
        <h2>Bir yapıdan<br /><em>daha fazlası.</em></h2>
        <div>
          <p class="large-copy">Biz, insanların hayatlarına dokunan mekanlar tasarlıyor ve inşa ediyoruz. Her projede estetik, dayanıklılık ve işlevselliği bir araya getiriyoruz.</p>
          <p class="muted-copy">Eskişehir'in dokusunu ve ihtiyaçlarını iyi biliyor; yerel deneyimimizi çağdaş yapı anlayışıyla buluşturuyoruz. Baştan sona güven veren bir çalışma ortağı oluyoruz.</p>
          <a class="underlined-link" href="#iletisim">Hikayemizi keşfedin <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="stats-strip">
      <div><strong>15+</strong><span>Yıllık deneyim</span></div>
      <div><strong>42</strong><span>Tamamlanan proje</span></div>
      <div><strong>100%</strong><span>Müşteri memnuniyeti</span></div>
      <div><strong>01</strong><span>Güvenilir çözüm ortağı</span></div>
    </section>

    <section class="projects-section" id="projeler">
      <div class="section-heading"><div><p class="section-label">02 / SEÇKİLER</p><h2>İz bırakan<br /><em>projeler.</em></h2></div><a class="underlined-link" href="#iletisim">Tüm projeler <span>↗</span></a></div>
      <div class="project-grid">
        <a class="project-card project-large" href="#iletisim"><img src={constructionImage.src} alt="Modern konut inşaatı projesi" /><div class="project-info"><span>01 — KONUT</span><h3>Park Evleri</h3><p>Tepebaşı, Eskişehir</p></div></a>
        <a class="project-card project-small" href="#iletisim"><img src={blueprintImage.src} alt="Mimari proje çizimleri" /><div class="project-info"><span>02 — TASARIM</span><h3>Çizgilerin Ötesi</h3><p>Odunpazarı, Eskişehir</p></div></a>
        <a class="project-card project-small" href="#iletisim"><img src={workersImage.src} alt="Şantiyede çalışan yapı ekibi" /><div class="project-info"><span>03 — TİCARİ</span><h3>Atölye 26</h3><p>Eskişehir Organize Sanayi</p></div></a>
      </div>
    </section>

    <section class="services-section" id="hizmetler">
      <div class="section-label">03 / HİZMETLERİMİZ</div>
      <div class="services-layout"><h2>Fikrinize<br /><em>şekil veriyoruz.</em></h2><div class="service-list"><div><span>01</span><h3>Proje Geliştirme</h3><p>İhtiyaçlarınızı analiz ediyor, doğru proje kurgusunu birlikte oluşturuyoruz.</p></div><div><span>02</span><h3>Mimari Tasarım</h3><p>Estetik ve işlevi dengeleyen, size özel ve geleceğe değer katan mekanlar tasarlıyoruz.</p></div><div><span>03</span><h3>Anahtar Teslim İnşaat</h3><p>Planlamadan teslimata kadar tüm süreci tek elden, şeffaf biçimde yönetiyoruz.</p></div></div></div>
    </section>

    <section class="contact-section" id="iletisim">
      <div><p class="eyebrow"><span></span> Birlikte başlayalım</p><h2>Hayalinizdeki<br /><em>yapıyı konuşalım.</em></h2><p>Projeniz için ilk adımı atmaya hazır mısınız? Bize ulaşın, ihtiyaçlarınızı dinleyelim.</p></div>
      <a class="button button-light" href="tel:+902222222222">Bize ulaşın <span>↗</span></a>
    </section>
  </div>
</MainLayout>

<style>
  .parkes-page { --ink:#20211e; --paper:#f3f1ec; --accent:#c36745; --line:#d6d1c8; color:var(--ink); background:var(--paper); margin:0 -2rem; font-family:Arial, Helvetica, sans-serif; }
  .parkes-page * { box-sizing:border-box; }
  .parkes-page h1,.parkes-page h2,.parkes-page h3,.parkes-page p { margin:0; }
  .parkes-page h1,.parkes-page h2 { font-weight:500; letter-spacing:-.065em; line-height:.92; }
  .parkes-page h1 { font-size:clamp(3.6rem,8vw,8rem); }
  .parkes-page h2 { font-size:clamp(3rem,6vw,6.5rem); }
  .parkes-page em { color:var(--accent); font-family:Georgia, serif; font-weight:400; }
  .parkes-hero { min-height:calc(100vh - 5rem); padding:5rem 5vw 3rem; display:grid; grid-template-columns:1.05fr .95fr; gap:4vw; position:relative; align-items:center; }
  .eyebrow,.section-label { font-size:.7rem; letter-spacing:.15em; font-weight:700; text-transform:uppercase; }
  .eyebrow { display:flex; align-items:center; gap:.65rem; margin-bottom:2rem; }
  .eyebrow span { width:28px; height:1px; background:var(--accent); display:inline-block; }
  .hero-lede { max-width:31rem; font-size:1.05rem; line-height:1.6; color:#686860; margin:2rem 0; }
  .hero-actions { display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; }
  .button { padding:1.05rem 1.3rem; display:inline-flex; align-items:center; gap:2rem; text-decoration:none; text-transform:uppercase; letter-spacing:.12em; font-size:.68rem; font-weight:700; }
  .button span { font-size:1.25rem; line-height:0; }
  .button-dark { background:var(--ink); color:#fff; }.button-light { background:#f3f1ec;color:var(--ink); }
  .text-link,.underlined-link { color:var(--ink); text-decoration:none; font-size:.75rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }.text-link span,.underlined-link span { color:var(--accent); margin-left:.45rem; font-size:1.1rem; }
  .hero-image-wrap { position:relative; height:min(68vh,620px); }.hero-image-wrap img { width:100%;height:100%;object-fit:cover;filter:saturate(.65); }.hero-badge { position:absolute; bottom:1.2rem; left:-2rem; background:var(--accent); color:#fff; width:105px;height:105px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center; }.hero-badge strong { font-size:1.7rem; }.hero-badge span { font-size:.62rem; text-transform:uppercase; letter-spacing:.1em; }.hero-note { position:absolute; bottom:1rem; left:5vw; font-size:.6rem; letter-spacing:.15em; color:#7d7b73; }
  .intro-section,.projects-section,.services-section { padding:8rem 7vw; }.section-label { color:#858178; margin-bottom:2rem; }.intro-content { display:grid;grid-template-columns:1fr 1fr;gap:8vw; }.large-copy { font-size:1.45rem;line-height:1.4; }.muted-copy { color:#77756d;line-height:1.7;margin:1.5rem 0 2rem;max-width:31rem; }.underlined-link { border-bottom:1px solid var(--ink); padding-bottom:.6rem; display:inline-block; }
  .stats-strip { background:var(--ink); color:var(--paper); display:grid;grid-template-columns:repeat(4,1fr); padding:3rem 7vw; }.stats-strip div { border-left:1px solid #4c4c46; padding-left:1.5rem; }.stats-strip strong { display:block;font-size:2.4rem;font-weight:400; }.stats-strip span { font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:#aaa89f; }
  .projects-section { background:#e7e3db; }.section-heading { display:flex;justify-content:space-between;align-items:end;margin-bottom:3.5rem; }.project-grid { display:grid;grid-template-columns:1.35fr 1fr;gap:1.3rem; }.project-card { display:block;text-decoration:none;color:var(--ink);position:relative;overflow:hidden;background:#d5d0c7; }.project-large { grid-row:span 2; }.project-card img { width:100%;height:100%;min-height:260px;object-fit:cover;display:block;filter:saturate(.65);transition:transform .5s; }.project-card:hover img { transform:scale(1.04); }.project-large img { min-height:640px; }.project-info { position:absolute;bottom:0;left:0;right:0;padding:1.5rem;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.75)); }.project-info span { font-size:.62rem;letter-spacing:.15em; }.project-info h3 { font-size:1.7rem;font-weight:400;margin:.35rem 0; }.project-info p { font-size:.8rem;color:#ddd; }
  .services-section { background:var(--paper); }.services-layout { display:grid;grid-template-columns:1fr 1fr;gap:8vw; }.service-list { border-top:1px solid var(--line); }.service-list>div { padding:1.5rem 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:2rem 1fr;column-gap:1rem; }.service-list span { color:var(--accent);font-size:.7rem; }.service-list h3 { font-size:1.2rem;font-weight:500; }.service-list p { color:#77756d;font-size:.9rem;line-height:1.5;margin-top:.6rem;grid-column:2; }
  .contact-section { background:var(--accent);color:#fff;padding:7rem 7vw;display:flex;align-items:end;justify-content:space-between;gap:3rem; }.contact-section .eyebrow span { background:#fff; }.contact-section h2 { margin-bottom:1.5rem; }.contact-section>div>p:last-child { max-width:27rem;line-height:1.6;color:#f6ddd4; }
  @media (max-width: 700px) { .parkes-page { margin:0 -1rem; }.parkes-hero { display:flex;flex-direction:column;padding:4rem 1.4rem 5rem;align-items:stretch;gap:2rem; }.parkes-hero h1 { font-size:3.8rem; }.hero-image-wrap { height:360px; }.hero-badge { left:auto;right:1rem;bottom:-1.8rem; }.hero-note { left:1.4rem;bottom:1.2rem;font-size:.52rem; }.intro-section,.projects-section,.services-section { padding:5rem 1.4rem; }.intro-content,.services-layout { grid-template-columns:1fr;gap:2.5rem; }.intro-content h2,.services-layout h2 { font-size:3.5rem; }.stats-strip { grid-template-columns:repeat(2,1fr);gap:2rem;padding:2.5rem 1.4rem; }.stats-strip div { padding-left:.8rem; }.stats-strip strong { font-size:2rem; }.section-heading { align-items:start;flex-direction:column;gap:1.5rem; }.section-heading h2 { font-size:3.7rem; }.project-grid { grid-template-columns:1fr; }.project-large { grid-row:auto; }.project-large img { min-height:410px; }.project-small img { min-height:290px; }.contact-section { padding:5rem 1.4rem;display:block; }.contact-section h2 { font-size:3.8rem; }.contact-section .button { margin-top:2rem; } }
</style>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector(link.getAttribute('href') || '');
      if (target) { event.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>

<style is:global>
  body { background:#f3f1ec !important; }
</style>

